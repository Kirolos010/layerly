# AI Design Studio - Root .htaccess
# Plain PHP Web Application on Apache / LiteSpeed

Options -Indexes
Options +FollowSymLinks

# Block access to configuration files and hidden files
<FilesMatch "^(config\.php|install\.php\.bak|\.env|\.git|\.htaccess|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to internal directories via rewrite rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known) - [F]
    RewriteRule ^(includes|storage|lang|database|tests)(/|$) - [F,L]
</IfModule>

# Security Headers (mod_headers fallback)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP Execution & Default Charset
AddDefaultCharset UTF-8
